{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocFusion",
  "version": "0.1.0",
  "identifier": "dev.docfusion.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DocFusion",
        "width": 900,
        "height": 700,
        "minWidth": 560,
        "minHeight": 420,
        "backgroundColor": "#151b23"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  }
}
