{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocFusion",
  "version": "0.1.0",
  "identifier": "io.github.wwkkyy0325.docfusion",
  "build": {
    "frontendDist": "ui"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "wwkkyy0325",
    "homepage": "https://github.com/wwkkyy0325/DocFusion",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DocFusion",
        "width": 900,
        "height": 700,
        "minWidth": 560,
        "minHeight": 420,
        "backgroundColor": "#151b23"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  }
}
